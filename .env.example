# ─── API interna: backend NestJS de FilaCero (Backend-Duo.exe) ───────────────
# Solo la usa el servidor de Next.js (Route Handlers /api/*). Nunca llega al
# navegador. Debe coincidir con el PORT del backend (por defecto 3000).
API_URL=http://localhost:3000

# Nombre de la cookie httpOnly donde se guarda el JWT (opcional).
AUTH_COOKIE_NAME=filacero_token

# "Continuar con Google": ID de cliente de OAuth (tipo "Aplicación web"), el
# MISMO que usa el backend. Cómo obtenerlo: ver .env.example del backend.
# Se lee en tiempo de ejecución (/api/auth/google/config); vacío = el botón
# avisa que el acceso con Google no está activado.
GOOGLE_CLIENT_ID=
