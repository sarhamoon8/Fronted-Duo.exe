    {
      "name": "2. Frontend BFF Next.js (cookie httpOnly)",
      "description": "Mismas operaciones pasando por el frontend (npm run dev en :3001). Postman guarda la cookie filacero_token automáticamente tras el login; no se usa {{token}}.",
      "item": [
        {
          "name": "Login → cookie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{front_url}}/api/auth/login",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Set-Cookie httpOnly', () => pm.expect(pm.response.headers.get('Set-Cookie') || '').to.match(/filacero_token=.*HttpOnly/i));",
                  "pm.test('No expone el token', () => pm.expect(pm.response.text()).to.not.include('accessToken'));"
                ]
              }
            }
          ]
        },
