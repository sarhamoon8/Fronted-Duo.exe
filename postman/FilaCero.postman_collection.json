  "item": [
    {
      "name": "1. Backend NestJS (Bearer)",
      "description": "Contrato original del backend. El token se guarda en {{token}} al hacer login/registro.",
      "item": [
        {
          "name": "Auth",
          "item": [
            {
              "name": "Registro (PACIENTE)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{api_url}}/auth/register",
                "description": "",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"Paciente Postman\",\n  \"email\": \"paciente{{$timestamp}}@correo.co\",\n  \"password\": \"secreta1\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "auth": {
                  "type": "noauth"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('200/201 con accessToken', () => pm.expect(pm.response.json()).to.have.property('accessToken'));",
                      "pm.environment.set('token', pm.response.json().accessToken);"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Login",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{api_url}}/auth/login",
                "description": "",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "auth": {
                  "type": "noauth"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('200/201 con accessToken', () => pm.expect(pm.response.json()).to.have.property('accessToken'));",
                      "pm.environment.set('token', pm.response.json().accessToken);"
                    ]
                  }
                }
              ]
            }
          ]
        },
