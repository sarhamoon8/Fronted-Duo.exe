# ─── API interna: backend NestJS de FilaCero (Backend-Duo.exe) ───────────────
# Solo la usa el servidor de Next.js (Route Handlers /api/*). Nunca llega al
# navegador. Debe coincidir con el PORT del backend (por defecto 3000).
API_URL=http://localhost:3000

# Nombre de la cookie httpOnly donde se guarda el JWT (opcional).
AUTH_COOKIE_NAME=filacero_token

# ─── API externa: Datos Abiertos Colombia (Socrata) — CUM de INVIMA ─────────
NEXT_PUBLIC_EXTERNAL_API_URL=https://www.datos.gov.co/resource
NEXT_PUBLIC_CUM_DATASET_ID=i7cb-raxc
# App token opcional de Socrata (https://dev.socrata.com/docs/app-tokens.html)
NEXT_PUBLIC_EXTERNAL_API_TOKEN=
